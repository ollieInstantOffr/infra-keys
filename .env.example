# ---------------------------------------------------------------- database
POSTGRES_USER=keys
POSTGRES_PASSWORD=change-me
POSTGRES_DB=keys
# used by the app container (compose rewrites the host to `db`)
DATABASE_URL="postgresql://keys:change-me@localhost:5432/keys?schema=public"

# ------------------------------------------------------------------- app
APP_URL=http://localhost:3000
PORT=3000

# 32 bytes, base64. Encrypts PII at rest (email addresses).
#   openssl rand -base64 32
APP_ENCRYPTION_KEY=
# 32 bytes, base64. HMAC key for blind indexes (email lookup, tag names).
APP_INDEX_KEY=
# 32 bytes, base64. Signs session cookies.
SESSION_SECRET=

# ----------------------------------------------------------------- email
RESEND_API_KEY=
EMAIL_FROM="keys <onboarding@resend.dev>"

# -------------------------------------------------------------- webauthn
# Must match the hostname the app is served from.
RP_ID=localhost
RP_NAME=keys
