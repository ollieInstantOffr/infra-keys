# ---------------------------------------------------------------- database
POSTGRES_USER=keys
POSTGRES_PASSWORD=change-me
POSTGRES_DB=keys
# used by the app container (compose rewrites the host to `db`)
DATABASE_URL="postgresql://keys:change-me@localhost:5432/keys?schema=public"

# ------------------------------------------------------------------- app
# The URL the BROWSER uses — not the container's internal address.
#
# This is load-bearing: session cookies are marked `Secure` when it is https,
# and left unmarked when it is http. Get it wrong and sign-in silently loops
# back to the login page, because the browser throws the cookie away.
#
#   local                 http://localhost:3000
#   behind a proxy        https://keys.example.com
APP_URL=http://localhost:3000
PORT=3000

# 32 bytes, base64. Encrypts PII at rest (email addresses).
#   openssl rand -base64 32
APP_ENCRYPTION_KEY=
# 32 bytes, base64. HMAC key for blind indexes (email lookup, tag names).
APP_INDEX_KEY=
# 32 bytes, base64. Signs session cookies.
SESSION_SECRET=

# ----------------------------------------------------------------- email
RESEND_API_KEY=
EMAIL_FROM="keys <onboarding@resend.dev>"

# -------------------------------------------------------------- webauthn
# Must match the hostname in APP_URL — the one the browser sees, which behind
# a reverse proxy is the public name, never the container's. A mismatch makes
# Touch ID fail with a SecurityError. /api/health tells you if it is wrong.
RP_ID=localhost
RP_NAME=keys
